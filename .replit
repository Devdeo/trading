run = "npm run dev"
modules = ["nodejs-20", "web"]
hidden = [".config", "package-lock.json", ".next", ".swc"]

[nix]
channel = "stable-25_05"

[env]
NEXT_TELEMETRY_DISABLED = "1"

[deployment]
run = ["npm", "run", "start"]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]

[[ports]]
localPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 38375
externalPort = 3000

[[ports]]
localPort = 43593
externalPort = 3001

[[ports]]
localPort = 45863
externalPort = 3002

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
expertMode = true
integrations = ["javascript_gemini:1.0.0"]
